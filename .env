# ================================================================
# CREADOR DE VIDEOS CON IA - Variables de Entorno
# ================================================================
# IMPORTANTE: Configura tus claves API reales desde el panel de
# tu plataforma de hosting (Variables de Entorno / Secrets),
# NO escribas claves reales directamente en este archivo.
# ================================================================

# Puerto del servidor (las plataformas cloud lo asignan automáticamente)
PORT=5000

# Clave API de OpenAI (para Whisper y DALL-E 3)
OPENAI_API_KEY=

# Clave API de Google Gemini (para escenas e Imagen 3)
GEMINI_API_KEY=
